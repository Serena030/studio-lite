# 给 systemd 的 EnvironmentFile 用；手动启动时请先 export 这些变量

STUDIO_PORT=8770
STUDIO_HOST=127.0.0.1
STUDIO_DB=./studio.db

# 干活的那条命令。单子内容从标准输入进去。
STUDIO_WORKER_CMD=claude -p

# 它在哪个目录里干活
STUDIO_WORKDIR=.

# 跑多久算超时（秒）
STUDIO_WORKER_TIMEOUT=1800

# 设了就必须带 X-Token 头。要放到公网上一定要设。
STUDIO_TOKEN=

# 1 = 新单自动派工。默认关着，不点就不烧额度。
STUDIO_AUTO_DISPATCH=0

# 可选：模型下拉、模型参数和附件目录
STUDIO_MODELS=sonnet,opus
STUDIO_MODEL_FLAG=--model
STUDIO_UPLOADS=./uploads
